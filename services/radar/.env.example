ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
WEB_ORIGIN=http://localhost:3000

## Firebase configuration
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_PROJECT_ID=decision-radar

## Google OAuth 2.0 configuration
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# This must be an exact Google Cloud OAuth redirect URI. In production, point it
# at the Next.js callback route so authorization codes stay inside the server tier.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/oauth/google/callback
GOOGLE_OAUTH_STATE_TTL_SECONDS=600
# Optional. Defaults to FIREBASE_PROJECT_ID in a deployed environment. Set this
# to the existing real GCP project that hosts Secret Manager when Firestore uses
# the local emulator project ID above.
GOOGLE_SECRET_MANAGER_PROJECT_ID=
